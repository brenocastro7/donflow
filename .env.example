# Local development placeholders only.
# Never put production credentials or third-party API keys in this file.
#
# This root file holds only infrastructure values shared by Docker Compose, the
# Prisma CLI, and the API process: the PostgreSQL container and the database
# connection string. Application configuration (JWT, auth, MFA, master bootstrap,
# CORS, email, storage) lives in apps/api/.env.example — copy it to apps/api/.env
# separately. Do not add API application variables here, and do not duplicate
# DATABASE_URL/POSTGRES_* in apps/api/.env: the API's env loader reads this root
# file for them, and keeping a single source avoids the API and the Prisma CLI
# ever pointing at different databases.
POSTGRES_USER=donflow_dev
POSTGRES_PASSWORD=change-me-before-use
POSTGRES_DB=donflow_dev
POSTGRES_PORT=5432

DATABASE_URL="postgresql://donflow_dev:change-me-before-use@localhost:5432/donflow_dev?schema=public"
