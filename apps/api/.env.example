# Local development placeholders only.
# Never put production credentials or third-party API keys in this file.
#
# This file holds the API's own application configuration. Database connection
# values (DATABASE_URL, POSTGRES_*) are intentionally NOT here — they live only
# in the root .env.example/.env, shared with Docker Compose and the Prisma CLI.
# Never add DATABASE_URL or POSTGRES_* to this file: doing so could make the
# running API and the Prisma CLI point at two different databases.

# Generate a unique secret for each environment. Never commit the real value.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=86400
AUTH_REMEMBER_REFRESH_TTL_SECONDS=2592000
MFA_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret

# Used only by the controlled `npm run bootstrap:master` command.
MASTER_NAME=Repository Owner
MASTER_EMAIL=owner@example.com
MASTER_PHONE=+351912345678
MASTER_PASSWORD=ReplaceWithStrongPassword1!

# Browser clients allowed to call the API. Separate multiple origins with commas.
APP_CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# The API's own public origin. Leave unset when the web app and API share an origin
# (local dev via the Vite proxy, or a same-host reverse-proxy deployment) — profile
# image links fall back to a relative path in that case. Required when the API is
# hosted on a different origin than the web app (e.g. Railway + Vercel), otherwise
# profile image URLs resolve against the wrong host and silently fail to load.
API_PUBLIC_URL=
# Keep disabled in production unless the API contract must be exposed deliberately.
ENABLE_API_DOCS=false
TRUST_PROXY=false

# Transactional email. Provider-neutral names: swapping providers later only
# means changing EMAIL_PROVIDER and the provider adapter, not these variable
# names. Keep EMAIL_PROVIDER=noop until private provider values exist.
EMAIL_PROVIDER=noop
EMAIL_API_KEY=re_dev_xxxxxxxxx
EMAIL_FROM_ADDRESS=no-reply@mail.example.com
EMAIL_FROM_NAME=Barbershop Name

# Profile-image storage. Memory is convenient locally but is cleared on restart.
# Use `r2` with private, bucket-scoped credentials for persistent environments.
# Provider-neutral names: swapping storage providers later only means changing
# STORAGE_PROVIDER and the provider adapter, not these variable names.
STORAGE_PROVIDER=memory
STORAGE_ACCOUNT_ID=your-cloudflare-account-id
STORAGE_ACCESS_KEY_ID=your-r2-access-key-id
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-access-key
STORAGE_BUCKET_NAME=your-private-bucket-name
STORAGE_ENDPOINT=https://your-cloudflare-account-id.eu.r2.cloudflarestorage.com
STORAGE_JURISDICTION=eu

# Error monitoring. Leave unset to disable Sentry entirely (e.g. local dev).
SENTRY_DSN=
